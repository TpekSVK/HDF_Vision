+/* CU55 image DMA can start at COMMIT. Allocate its complete receive pool
+ * before COMMIT, but do not overlap bulk IN with the endpoint reset in COMMIT.
+ * Submit immediately after COMMIT returns, without allocating in that gap. */
+static bool uvc_cu55_bulk_preallocate(struct uvc_streaming *stream)
+{
+ return stream->type == V4L2_BUF_TYPE_VIDEO_CAPTURE &&
+        stream->intf->num_altsetting == 1 &&
+        le16_to_cpu(stream->dev->udev->descriptor.idVendor) == 0x2560 &&
+        le16_to_cpu(stream->dev->udev->descriptor.idProduct) == 0xc155;
+}
+
 /*
